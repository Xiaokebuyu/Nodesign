node_modules/
.env
.env.local
.env.*.local
.env.bak*
.env.backup*
.DS_Store

# 数据库
server/db/*.db
server/db/*.db-wal
server/db/*.db-shm

# 运行时产物（每个 run 一个 workspace）
server/runs/*/
!server/runs/.gitkeep

# Per-project workspace 目录（持久化，含 canvas.html / spec.json / .git / assets）
# 每个 project 一个子目录，纯 dev 数据，不入仓
server/projects-data/

# 服务端缓存（首页封面截图等，按源 mtime 重建，删了自愈）
server/.cache/
server/server/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# 已安装 skill 的本地副本（symlink 不入库；部署时由 ci 打包）
server/skills/installed/*/
!server/skills/installed/.gitkeep

# 日志
logs/
*.log

# 编辑器
.vscode/
.idea/
*.swp

# 前端构建产物（Nodesign/web/）
web/dist/
web/.vite/
web/coverage/

# 锁文件（暂时全保留；如果未来分仓只保留各自的，再细化）
.claude/scheduled_tasks.lock

# 本地 .claude 配置 / 缓存（agent 工具会自动写，不入仓）
# 真正的运行时配置走代码里 SDK options（loop.js / session-loop.js 通过
# settings: { skipWebFetchPreflight } 显式注入）+ runtime/platform.js
.claude/settings.json
.claude/settings.local
.claude/settings.local.json

# rembg python venv（一次性 setup：cd server && python3 -m venv .venv-rembg
# && .venv-rembg/bin/python3 -m pip install rembg onnxruntime；u2net.onnx
# 模型缓存到 ~/.u2net/ 全局，不在 repo 里）
server/.venv-rembg/

# 构建暂存区（deploy.sh 用；真正上线的是 web/dist）
web/dist-build/

# chromium 崩溃现场（08-16 那次 Page crashed 留的 4.5MB core dump）
core

# Agent worktree 隔离留下的临时工作树
.claude/worktrees/

# 误提交过的缓存（cwd=server 时 process.cwd()/server/.cache 的产物；cacheRoot 08-22 起走 runtime/profile.js 不再生成）
server/server/

# 登录墙像素守门的基线图（会话内 A/B 用，几 MB，不入仓）
web/scripts/__baseline__/
