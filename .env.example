# === Nodesign 服务端环境变量 ===
# 复制为 .env 后填入真实值：cp .env.example .env

# ── 服务端口 ──
PORT=4001

# ── LLM：Kimi K2.6（Moonshot AI Anthropic 兼容端点）──
# 文档：https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# ⚠️ 兼容层会主动缩放 temperature：real_temp = request_temp * 0.6（调参时记得）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/anthropic
KIMI_MODEL=kimi-k2.6
KIMI_SUMMARY_MODEL=kimi-k2.6

# ── 救场 fallback：官方 Anthropic（实测 Kimi 创造性长文本不达标时切）──
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-4-7
# ENGINE_LLM_PROVIDER=kimi      # kimi | anthropic（阶段 1 实现切换器）

# ── Engine 行为 ──
ENGINE_TOOL_TIMEOUT_MS=60000      # 工具执行超时（preview/playwright 留足余量）
ENGINE_RUN_TIMEOUT_MS=1800000     # 单 run 全局超时（30 分钟）
ENGINE_MAX_TOKENS=16000           # 单轮 max_tokens
ENGINE_MAX_ROUNDS=60              # tool use 循环上限（K2.6 支持 4000+ 步，此处保守）
ENGINE_THINKING_BUDGET=4000       # 思考预算

# ── 并发控制（SaaS 上线前基于 Kimi 配额 + playwright 实例数重新算）──
ENGINE_MAX_CONCURRENT_LLM=5
ENGINE_MAX_QUEUE_DEPTH=3

# ── 工作区/产物目录 ──
WORKSPACE_DIR=./server/runs
ARTIFACT_DIR=./server/runs

# ── Skill 路径 ──
# 默认 symlink 到 /Users/edy/Desktop/html_designer/v0.7.5/deskskill-engine-v0.7.5
# 部署时改为打包进 server/skills/installed/
SKILLS_DIR=./server/skills/installed

# ── 数据库（MVP 先 SQLite，量大切 pg）──
DB_PATH=./server/db/nodesign.db

# ── 鉴权（待组长确认"已有平台"后再定）──
# JWT_SECRET=
# AUTH_PROVIDER=platform        # platform | self | none

# ── CORS ──
# CORS_ORIGIN=https://nodesign.your-domain.com

# ── 内部调用 token（小合 → Nodesign 服务间调用用）──
INTERNAL_API_TOKEN=

# ── Playwright（preview 工具用）──
# PLAYWRIGHT_BROWSERS_PATH=
# 无头模式默认开；要 debug 时设 PWDEBUG=1
