# === Nodesign 服务端环境变量（线上多用户站用）===
# 复制为 .env 后填入真实值：cp .env.example .env
# ⚠️ 本地分发版（NODESIGN_PROFILE=local / npx nodesign）不读仓库根的 .env：钥匙写在 ~/.nodesign/.env，
#    或打开 /settings 的「钥匙与开关」页填；模型插槽在 ~/.nodesign/config.json（形状见 server/runtime/local-config.js）。
#    下面 NoDesk 网关那一段是历史（已退役），线上现役通路见 server/engine/agent/model-table.js。

# ── 服务端口 ──
PORT=4001

# ── LLM Gateway（NoDesk AI Gateway，2026-05-08 主/子 channel 分流）──
# 架构：
#   SDK binary → binary-fixup-proxy（按 body.model 分流注入 channel + channel_url）
#                                  → NoDesk Gateway /default/passthrough
#                                  ├─ main: kimi-* → moonshot.cn /anthropic/v1/messages
#                                  └─ sub : 其他   → DMXAPI /v1/messages
#
# NoDesk 网关地址（含 protocol 不含 path；proxy 自动拼 /default/passthrough）：
NODESIGN_GATEWAY_URL=https://llm-gateway-api.nodesk.tech
# NoDesk 网关 Key（不是下游真实 Key；NoDesk 后台创建项目时生成）：
NODESIGN_GATEWAY_KEY=
# 主 agent model：
NODESIGN_MODEL=kimi-k2.6
# 快速 model（subagent + SDK helper 共用；DMXAPI -cc 系列 = Claude Code 协议、3.4 折）：
NODESIGN_FAST_MODEL=claude-haiku-4-5-20251001-cc
# 主代理 channel（kimi-* model 命中）—— 走 moonshot.cn anthropic 兼容端点。
# 严禁切到 OpenAI 端点 /v1/chat/completions：SSE 是 chat.completion.chunk，SDK 解析不了。
NODESIGN_GATEWAY_MAIN_CHANNEL=kimi
NODESIGN_GATEWAY_MAIN_CHANNEL_URL_BASE=https://api.moonshot.cn/anthropic
# 子 channel（其他 model 命中，默认 fastModel haiku-cc 走这条）—— DMXAPI：
NODESIGN_GATEWAY_CHANNEL=DMX
NODESIGN_GATEWAY_CHANNEL_URL_BASE=https://www.dmxapi.cn

# ── Engine 行为 ──
# streamInput 模式下 maxTurns / maxBudgetUsd 是**全局累计**（query 横跨整个 session），
# 不像之前 per-turn 重置。详见 session-loop.js
NODESIGN_MAX_TURNS=50
# 预算上限（美元，全 session 累计）。Kimi 价位下 5$ 通常够，但 agent 跑到接近上限
# 时会变保守（少调工具、少派子代理、收尾仓促）。提到 10 给充裕的迭代空间。
NODESIGN_MAX_BUDGET_USD=10

# ── 并发控制（仍由 shared/concurrency.js 管，跟 SDK 正交）──
ENGINE_MAX_CONCURRENT_LLM=5
ENGINE_MAX_QUEUE_DEPTH=3

# ── workspace 软链（macOS / Linux 默认 OK；不支持 symlink 时强制降级 warn）──
# 不要随便设；只在 git 报"symlink failed"时考虑（Windows / 部分 docker volume）
# NODESIGN_ALLOW_SYMLINK_FALLBACK=1

# ── 工作区/产物目录 ──
WORKSPACE_DIR=./server/runs
ARTIFACT_DIR=./server/runs

# ── Project workspace（per-project 持久化目录，git 管 history）──
# 每个 project 一个独立目录，内含 canvas.html / spec.json / assets/ / .claude/skills/ / .git
PROJECTS_DATA_DIR=./server/projects-data

# ── Skill 路径（SKILL.md 标准格式）──
# Nodesign 自带 skills 在 server/engine/skills/<id>/SKILL.md
# 默认即 server/engine/skills，覆盖时用 NODESIGN_SKILLS_DIR
# NODESIGN_SKILLS_DIR=

# ── 数据库（MVP 先 SQLite，量大切 pg）──
DB_PATH=./server/db/nodesign.db

# ── 鉴权（2026-07-30 多用户内测版）──
# 单密码时代的 NODESIGN_AUTH_PASSWORD 仍要保留：users 表为空时启动 bootstrap
# 会用它建 admin 账号（用户名 admin）
# NODESIGN_AUTH_PASSWORD=
# token 签名密钥（固定随机值，openssl rand -hex 32；换值=全员重登）
# NODESIGN_AUTH_SECRET=
# 每用户每日 token 限额（input+output，Asia/Shanghai 日界；admin 不限，默认 3000000）
# NODESIGN_USER_DAILY_TOKENS=3000000
# 并发闸门：全局同时在跑的 turn 上限（默认 3）/ 每用户上限（默认 1）
# NODESIGN_MAX_CONCURRENT_RUNS=3
# NODESIGN_USER_CONCURRENT_RUNS=1
# 邀请码：node server/scripts/invite.mjs（--uses N --days N --list）
# 会话 cookie 基名（默认 nd_auth；https 下实际名字是 __Host-<基名>）。同主机的第二个实例（exp）必须换一个，
# 否则两边登录互相覆盖
# NODESIGN_SESSION_COOKIE=nd_auth
# 旧登录状态（09-13 前的 v2 token）在 https 下认到什么时候，ISO 时间；不设 = 不认（全员重新登录）
# NODESIGN_LEGACY_TOKEN_UNTIL=
# 退出 / 换发时连父域那份旧 cookie 一起清（发布页在 *.share.<父域> 下时设）
# NODESIGN_COOKIE_PARENT_DOMAIN=xiaobuyu.trade
# 开放注册（不带邀请码也能注册，落 basic 档）
# NODESIGN_OPEN_REGISTRATION=1

# ── 事务邮件（验证码 / 找回密码 / 安全通知，ops/aws/ses.yaml）──
# 界面上露不露邮箱注册 / 验证码登录 / 找回密码 / 绑定邮箱（SES 脱离沙盒前别开：真实邮箱收不到信）
# NODESIGN_EMAIL_AUTH=1
# 找不回密码时给用户看的联系邮箱（没绑邮箱的老账号用）；不设就不显示
# NODESIGN_SUPPORT_EMAIL=
# ses | log | memory；不设时钥匙齐了用 ses，否则 log（不真发，只打一行日志）
# NODESIGN_MAIL_PROVIDER=
# NODESIGN_SES_REGION=ap-northeast-1
# 只能发信的 IAM 用户（栈输出 SenderUserName）的访问密钥；故意不用通用的 AWS_ACCESS_KEY_ID
# NODESIGN_SES_ACCESS_KEY_ID=
# NODESIGN_SES_SECRET_ACCESS_KEY=
# NODESIGN_SES_CONFIG_SET=nodesign-ses-transactional
# NODESIGN_MAIL_FROM=noreply@nodesign.xiaobuyu.trade
# NODESIGN_MAIL_FROM_NAME=NoDesign
# log 模式下把正文（含验证码）也打进日志，只在本机调试时开
# NODESIGN_MAIL_LOG_BODY=

# ── 第三方登录（Google / GitHub，hosted/auth/oauth-providers.js）──
# 没配的那家不出现在登录页。回调地址：<NODESIGN_PUBLIC_ORIGIN>/api/auth/oauth/{google|github}/callback
# NODESIGN_PUBLIC_ORIGIN=https://nodesign.your-domain.com
# NODESIGN_GOOGLE_CLIENT_ID=
# NODESIGN_GOOGLE_CLIENT_SECRET=
# NODESIGN_GITHUB_CLIENT_ID=
# NODESIGN_GITHUB_CLIENT_SECRET=

# ── CORS ──
# CORS_ORIGIN=https://nodesign.your-domain.com

# ── 内部调用 token（小合 → Nodesign 服务间调用用）──
INTERNAL_API_TOKEN=

# ── Playwright（preview 工具用）──
# PLAYWRIGHT_BROWSERS_PATH=
# 无头模式默认开；要 debug 时设 PWDEBUG=1

# ── 抠图（rembg 常驻服务）──
# 质量上限。超过它的档位显式拒绝并说明原因，不静默降档。
#   fast     = isnet，无 alpha matting，峰值 ~890MB
#   balanced = isnet + alpha matting（AM 限 1024 长边），峰值 ~920MB
#   best     = birefnet-general-lite + AM，峰值 2.4GB+，小内存机器会被 OOM kill
# 3.9G 无 swap 的机器实测只能到 balanced；加了 swap 或换大内存机器再放开 best。
# NODESIGN_REMBG_QUALITY_CAP=balanced
# alpha matting 的分辨率上限（长边 px）。0 = 不限（会随图片像素数吃内存和时间）。
# NODESIGN_REMBG_AM_MAX_DIM=1024
# onnxruntime intra-op 线程数。单核机器保持 1，多线程只是每条线程再占一份缓冲。
# NODESIGN_REMBG_THREADS=1
# RSS 看门狗：常驻服务超过这个内存且空闲时回收重开（0 = 关掉）。
# onnxruntime + pymatting 的高水位不会自己降，2026-07-31 就是它把机器推进内存
# 抖动的（详见 services/rembg-launcher.js 文件头）。
# NODESIGN_REMBG_MAX_RSS_MB=900
# NODESIGN_REMBG_WATCH_MS=60000
