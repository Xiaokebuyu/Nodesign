# === Nodesign 服务端环境变量 ===
# 复制为 .env 后填入真实值：cp .env.example .env

# ── 服务端口 ──
PORT=4001

# ── LLM Gateway（Anthropic 协议兼容端点，2026-04-29 战略转向）──
# Nodesign 走 Claude Agent SDK，SDK spawn claude binary subprocess，
# binary 通过 ANTHROPIC_BASE_URL + ANTHROPIC_API_KEY 路由到 gateway。
#
# tokendance gateway（用户提供）：
NODESIGN_GATEWAY_URL=https://tokendance.space/gateway
# 注：tokendance Anthropic 协议端点是 /gateway/v1/messages（不带 /anthropic 段）
#     SDK 会自动追加 /v1/messages，所以这里只填到 /gateway
NODESIGN_GATEWAY_KEY=
NODESIGN_MODEL=kimi-k2.6
#
# 注：loop.js 优先读 NODESIGN_GATEWAY_*，未设时 fallback 到标准 ANTHROPIC_*
# 即直接 export ANTHROPIC_API_KEY=xxx ANTHROPIC_BASE_URL=https://... 也兼容

# ── 旧 Kimi 直连（已弃，agent loop 改走 SDK 后不再用）──
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/anthropic

# ── 救场 fallback：官方 Anthropic ──
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# NODESIGN_MODEL=claude-opus-4-7

# ── Engine 行为 ──
# 之前的 ENGINE_TOOL_TIMEOUT_MS / ENGINE_MAX_ROUNDS 等已不再生效（SDK 内部管），
# 留 maxTurns/effort 走 modelOverride（loop.js 调用层传入）

# ── 并发控制（仍由 shared/concurrency.js 管，跟 SDK 正交）──
ENGINE_MAX_CONCURRENT_LLM=5
ENGINE_MAX_QUEUE_DEPTH=3

# ── 工作区/产物目录 ──
WORKSPACE_DIR=./server/runs
ARTIFACT_DIR=./server/runs

# ── Skill 路径（SKILL.md 标准格式）──
# Nodesign 自带 skills 在 server/engine/skills/<id>/SKILL.md
# 默认即 server/engine/skills，覆盖时用 NODESIGN_SKILLS_DIR
# NODESIGN_SKILLS_DIR=

# ── 数据库（MVP 先 SQLite，量大切 pg）──
DB_PATH=./server/db/nodesign.db

# ── 鉴权（待组长确认"已有平台"后再定）──
# JWT_SECRET=
# AUTH_PROVIDER=platform        # platform | self | none

# ── CORS ──
# CORS_ORIGIN=https://nodesign.your-domain.com

# ── 内部调用 token（小合 → Nodesign 服务间调用用）──
INTERNAL_API_TOKEN=

# ── Playwright（preview 工具用）──
# PLAYWRIGHT_BROWSERS_PATH=
# 无头模式默认开；要 debug 时设 PWDEBUG=1
